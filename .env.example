# Local development configuration. Set production secrets in your hosting dashboard.
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=
PG_POOL_MAX=1

# Optional: provision the first Admin account on an empty database.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# Optional local Microsoft SQL Server settings. Without a local SQL Server,
# the app falls back to the local SQLite database.
DB_USER=sa
DB_PASSWORD=YourPassword123
DB_SERVER=localhost
DB_DATABASE=SalesInventoryDB
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
